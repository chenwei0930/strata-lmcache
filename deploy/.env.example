# Copy to .env and edit.
#
# MODEL: a size Strata knows (IQ3_XXS, Q2_0, ...), or empty to let it choose.
# STRATA_MODEL_DIR: a folder with the GGUF files.  Mounted read-only at /models.
# API_KEY: at least 16 characters; the entrypoint serves beyond loopback and
#          always needs a key.  `openssl rand -hex 24` makes one.
# LMCACHE_MAX_BYTES: RAM budget of the shared cache.  Leave room for the four
#          engines' experts, the OS and /dev/shm.  This is bytes, not GiB.
MODEL=IQ3_XXS
STRATA_MODEL_DIR=./models
API_KEY=change-me-please-123456
LMCACHE_MAX_BYTES=68719476736
